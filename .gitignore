
@'
# Local environment files and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# IDE and system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# AWS credentials and private keys
.aws/
*.pem
*.key
*.p12
*.pfx

# Logs and temporary files
*.log
*.tmp
'@ | Set-Content -Path .gitignore -Encoding utf8
